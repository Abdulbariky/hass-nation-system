# Copy this file to .env and fill in real values before deploying.
# For running locally on your laptop today, the defaults below are fine as-is.

PORT=3000

# Staff now log in individually (services/auth.js) — see "npm run create-admin"
# in the README. There is no shared API key anymore.

# SMS provider: "console" (default, just logs to the terminal) or "africastalking"
SMS_PROVIDER=console
# AT_API_KEY=
# AT_USERNAME=

# Leave unset to use the default local SQLite file (hass_nation.db in this folder).
# DB_PATH=/custom/path/to/hass_nation.db

# ---- M-Pesa top-up (Safaricom Daraja) — BUILT, NOT LIVE ----
# See README "M-Pesa top-up" before touching any of this. Leave MPESA_MOCK=true
# (the default) to exercise the full flow locally with no Safaricom account,
# shortcode, or public URL at all.
MPESA_MOCK=true
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=REPLACE_WITH_DARAJA_CONSUMER_KEY
MPESA_CONSUMER_SECRET=REPLACE_WITH_DARAJA_CONSUMER_SECRET
MPESA_SHORTCODE=REPLACE_WITH_SHORTCODE
MPESA_PASSKEY=REPLACE_WITH_DARAJA_PASSKEY
# Must be a publicly reachable HTTPS URL Safaricom's servers can reach —
# never localhost (use an ngrok tunnel while integration-testing against
# the Daraja sandbox; your real deployed domain in production). Keep the
# secret path segment matching MPESA_CALLBACK_SECRET below.
MPESA_CALLBACK_URL=https://REPLACE-WITH-PUBLIC-HTTPS-URL/api/mpesa/callback/REPLACE_WITH_CALLBACK_SECRET
# A random string only you and your callback URL know, so a stranger can't
# POST fake "payment succeeded" callbacks at your public endpoint. Generate
# one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
MPESA_CALLBACK_SECRET=REPLACE_WITH_RANDOM_SECRET
